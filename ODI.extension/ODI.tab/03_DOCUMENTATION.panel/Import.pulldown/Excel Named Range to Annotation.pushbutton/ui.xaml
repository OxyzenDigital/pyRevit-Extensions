<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel Named Range to Annotation"
        Height="550" Width="900" MinHeight="460" MinWidth="720"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}">

    <Window.Resources>
        <!-- Semantic Palette (Light Theme Defaults) -->
        <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#EBF4FA"/>
        <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FooterBrush" Color="#EFEFEF"/>
        <SolidColorBrush x:Key="AltRowBrush" Color="#FAFAFA"/>

        <SolidColorBrush x:Key="TextBrush" Color="#333333"/>
        <SolidColorBrush x:Key="TextLightBrush" Color="#888888"/>
        <SolidColorBrush x:Key="HeaderTextBrush" Color="#111827"/>

        <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#E5E5E5"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#CCE8FF"/>
        <SolidColorBrush x:Key="SelectionBorderBrush" Color="#0078D7"/>
        <SolidColorBrush x:Key="SelectionTextBrush" Color="#000000"/>
        <SolidColorBrush x:Key="InactiveSelectionBrush" Color="#E0E0E0"/>

        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#DCDCDC"/>
        <SolidColorBrush x:Key="CardTextBrush" Color="#000000"/>
        <SolidColorBrush x:Key="CardSubTextBrush" Color="#666666"/>
        <SolidColorBrush x:Key="CardLabelBrush" Color="#888888"/>
        <SolidColorBrush x:Key="CardValueBrush" Color="#000000"/>
        <SolidColorBrush x:Key="CardAccentBrush" Color="#0078D7"/>

        <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#FFFFFF"/>

        <!-- Control Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ComboBox Toggle & Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
                <Path Data="M0,0 L4,4 L8,0 z"
                      Fill="{TemplateBinding Foreground}"
                      HorizontalAlignment="Right"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"/>
            </Border>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource ControlBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True" MaxHeight="220">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Styles -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource AltRowBrush}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="{Binding LinkHintToolTip}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border -->
    <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Split Pane Workspace -->
                <RowDefinition Height="Auto"/> <!-- Footer Status & Action Bar -->
            </Grid.RowDefinitions>

            <!-- Row 0: Custom Draggable Header -->
            <Border Name="HeaderDrag" Grid.Row="0"
                    Background="{DynamicResource ToolbarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Excel Named Range to Annotation"
                                   Foreground="{DynamicResource HeaderTextBrush}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="|  Table Import &amp; Sync"
                                   Foreground="{DynamicResource TextLightBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Name="Btn_WinClose"
                            Grid.Column="1"
                            Content="✕"
                            Width="28" Height="28"
                            Style="{StaticResource TitleCloseButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Row 1: Split-Pane Workspace -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="260"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Project Excel Tables -->
                <Border Grid.Column="0"
                        Background="{DynamicResource ControlBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header strip -->
                            <RowDefinition Height="*"/>    <!-- Tables DataGrid -->
                            <RowDefinition Height="Auto"/> <!-- Batch action buttons -->
                        </Grid.RowDefinitions>

                        <!-- Left Header Bar -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource ToolbarBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="PROJECT EXCEL TABLES"
                                           Foreground="{DynamicResource CardLabelBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" Grid.Column="1">
                                    <Button Name="Btn_SelectAllLinked"
                                            Content="All"
                                            Width="36" Height="22"
                                            Margin="0,0,4,0"
                                            FontSize="11"/>
                                    <Button Name="Btn_SelectNoneLinked"
                                            Content="None"
                                            Width="42" Height="22"
                                            FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tables DataGrid -->
                        <DataGrid Name="Grid_LinkedTables" Grid.Row="1"
                                  ItemsSource="{Binding LinkedTables}"
                                  SelectedItem="{Binding SelectedLinkedTable, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="32">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Table" Width="*" Binding="{Binding FamilyName}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="File" Width="*" Binding="{Binding FileName}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Source" Width="*" Binding="{Binding DisplaySource}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status" Width="75" Binding="{Binding StatusText}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Left Pane Actions -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource FooterBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Name="Btn_UpdateChecked"
                                        Content="Update Checked"
                                        IsEnabled="{Binding CanUpdateChecked}"
                                        Height="26"
                                        Margin="0,0,6,0"/>
                                <Button Name="Btn_PlaceSelected"
                                        Content="Place in View"
                                        IsEnabled="{Binding CanPlaceSelected}"
                                        Height="26"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Grid Splitter -->
                <GridSplitter Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"
                              ShowsPreview="True"/>

                <!-- Right Pane: Configuration Card -->
                <Border Grid.Column="2"
                        Margin="15"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Row 0: Card Title -->
                            <RowDefinition Height="Auto"/> <!-- Row 1: Saved Sources -->
                            <RowDefinition Height="Auto"/> <!-- Row 2: File -->
                            <RowDefinition Height="Auto"/> <!-- Row 3: Link Hint Banner -->
                            <RowDefinition Height="Auto"/> <!-- Row 4: Sheet -->
                            <RowDefinition Height="Auto"/> <!-- Row 5: Range -->
                            <RowDefinition Height="Auto"/> <!-- Row 6: Name -->
                            <RowDefinition Height="Auto"/> <!-- Row 7: Scale -->
                            <RowDefinition Height="Auto"/> <!-- Row 8: Placement -->
                            <RowDefinition Height="*"/>    <!-- Row 9: Spacer -->
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <TextBlock Grid.Row="0"
                                   Text="IMPORT &amp; TABLE CONFIGURATION"
                                   Foreground="{DynamicResource CardLabelBrush}"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Margin="0,0,0,16"/>

                        <!-- Saved Sources -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Saved Sources:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox Name="Cb_RecentFiles"
                                      Grid.Column="1"
                                      ItemsSource="{Binding RecentFiles}"
                                      SelectedItem="{Binding SelectedRecentFile, Mode=TwoWay}"
                                      ToolTip="{Binding SelectedRecentFile}"/>
                        </Grid>

                        <!-- Excel File -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Excel File:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox Name="Tb_FilePath"
                                     Grid.Column="1"
                                     Text="{Binding FilePath, Mode=OneWay}"
                                     IsReadOnly="True"/>
                            <Button Name="Btn_Browse"
                                    Grid.Column="2"
                                    Content="Browse..."
                                    Width="70"
                                    Height="26"
                                    Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Link Hint Banner -->
                        <Border Grid.Row="3"
                                Background="{DynamicResource WindowBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,5"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding LinkedFileHint}"
                                       ToolTip="{Binding LinkedFileHint}"
                                       Foreground="{DynamicResource TextLightBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <!-- Worksheet -->
                        <Grid Grid.Row="4" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Worksheet:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox Name="Cb_Sheets"
                                      Grid.Column="1"
                                      ItemsSource="{Binding Sheets}"
                                      SelectedItem="{Binding SelectedSheet, Mode=TwoWay}"/>
                        </Grid>

                        <!-- Named Range -->
                        <Grid Grid.Row="5" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Named Range:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox Name="Cb_Ranges"
                                      Grid.Column="1"
                                      ItemsSource="{Binding Ranges}"
                                      SelectedItem="{Binding SelectedRange, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DisplayMeta}" Foreground="{DynamicResource TextLightBrush}" FontWeight="Normal"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Table Name -->
                        <Grid Grid.Row="6" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Table Name:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox Name="Tb_Name"
                                     Grid.Column="1"
                                     Text="{Binding TableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Text Scale -->
                        <Grid Grid.Row="7" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Text Scale (%):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox Name="Tb_Scale"
                                     Grid.Column="1"
                                     Text="{Binding TextScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80"
                                     HorizontalAlignment="Left"/>
                        </Grid>

                        <!-- Placement Option -->
                        <Grid Grid.Row="8" Margin="0,6,0,0">
                            <CheckBox Name="Cb_PlaceOnView"
                                      IsChecked="{Binding PlaceOnView, Mode=TwoWay}"
                                      Content="Place annotation instance in active view after creation"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 2: Status & Main Action Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource FooterBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Name="Lb_Status"
                               Grid.Column="0"
                               Text="{Binding StatusText}"
                               Foreground="{DynamicResource TextLightBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="Btn_Import"
                                Content="{Binding ImportButtonText}"
                                IsEnabled="{Binding CanImport}"
                                IsDefault="True"
                                Width="170"
                                Height="30"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Name="Btn_Close"
                                Content="Close"
                                IsCancel="True"
                                Width="80"
                                Height="30"
                                Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
