<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontSize="13"
        Height="980" Width="1580" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Quantify & Measure Exact Color Schema -->
        <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#EBF4FA"/>
        <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#333333"/>
        <SolidColorBrush x:Key="TextLightBrush" Color="#888888"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
        <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#CCE8FF"/>
        <SolidColorBrush x:Key="SelectionBorderBrush" Color="#0078D7"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="FooterBrush" Color="#EFEFEF"/>
        <SolidColorBrush x:Key="AltRowBrush" Color="#FAFAFA"/>

        <SolidColorBrush x:Key="CardBorderBrush" Color="#DCDCDC"/>
        <SolidColorBrush x:Key="SelectionTextBrush" Color="Black"/>
        <SolidColorBrush x:Key="InactiveSelectionBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="CardTextBrush" Color="#000000"/>
        <SolidColorBrush x:Key="CardSubTextBrush" Color="#666666"/>
        <SolidColorBrush x:Key="CardLabelBrush" Color="#888888"/>
        <SolidColorBrush x:Key="CardValueBrush" Color="#000000"/>
        <SolidColorBrush x:Key="CardAccentBrush" Color="#0078D7"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#991B1B"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#166534"/>
        <SolidColorBrush x:Key="UpdateBrush" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="UpdateTextBrush" Color="#92400E"/>
        <SolidColorBrush x:Key="ExtraBrush" Color="#FCE8FF"/>
        <SolidColorBrush x:Key="ExtraTextBrush" Color="#831843"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="DarkGridTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style x:Key="DarkGridTextLightStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <ControlTemplate TargetType="{x:Type ToggleButton}" x:Key="ComboBoxToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                <Border Grid.Column="0" CornerRadius="3" Margin="1" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
        </ControlTemplate>

        <ControlTemplate TargetType="{x:Type TextBox}" x:Key="ComboBoxTextBox">
            <Border x:Name="PART_ContentHost" Focusable="False" Background="{TemplateBinding Background}" />
        </ControlTemplate>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="3,3,23,3" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Template="{StaticResource ComboBoxTextBox}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,3,23,3" Focusable="True" Background="Transparent" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource ControlBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="true">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InactiveSelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <!-- Custom Expander Style -->
        <Style x:Key="ExpanderHeaderToggleButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid Background="Transparent" SnapsToDevicePixels="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="circle" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Height="18" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" Fill="Transparent"/>
                                <Path x:Name="arrow" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" SnapsToDevicePixels="False"/>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,0,0,0" RecognizesAccessKey="True" SnapsToDevicePixels="True" ContentSource="Content" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="arrow" Property="Data" Value="M 0,2 L 4,6 L 8,2"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="circle" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="3" SnapsToDevicePixels="True">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              DockPanel.Dock="Top"
                                              Style="{StaticResource ExpanderHeaderToggleButtonStyle}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontStretch="{TemplateBinding FontStretch}"
                                              FontStyle="{TemplateBinding FontStyle}"
                                              FontWeight="{TemplateBinding FontWeight}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter x:Name="ExpandSite"
                                                  DockPanel.Dock="Bottom"
                                                  Focusable="False"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"
                                                  Visibility="Collapsed"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter Property="Visibility" TargetName="ExpandSite" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base TreeView Item Style -->
        <Style TargetType="{x:Type TreeViewItem}" x:Key="BaseTreeItemStyle">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="19"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" Height="16" Padding="5" Width="16">
                                            <Path x:Name="ExpandPath" Data="M0,0 L0,6 L6,0 z" Fill="{DynamicResource TextLightBrush}" Stroke="{DynamicResource TextLightBrush}">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="135" CenterX="3" CenterY="3"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="RenderTransform" TargetName="ExpandPath">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" CenterX="3" CenterY="3"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Fill" TargetName="ExpandPath" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Stroke" TargetName="ExpandPath" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.Row="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False"><Setter Property="Visibility" TargetName="ItemsHost" Value="Collapsed"/></Trigger>
                            <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" TargetName="Expander" Value="Hidden"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseTreeItemStyle}"/>
        <Style TargetType="{x:Type TreeViewItem}" x:Key="TargetSchemaTreeItemStyle" BasedOn="{StaticResource BaseTreeItemStyle}">
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
        </Style>

        <!-- TabControl and TabItem Styles -->
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- REUSABLE MATRIX CELL TEMPLATE -->
        <DataTemplate x:Key="MatrixCellTemplate">
            <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1" Padding="5" MinHeight="64">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sheet Pills in this [Row, Column] Cell -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Sheets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding ActionBrush}" BorderThickness="4,1,1,1" CornerRadius="4" Margin="0,0,0,4" Padding="6,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChecked}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Include Checkbox -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,5,0" ToolTip="Include this sheet in Push to Revit"/>

                                        <!-- Clickable Sheet Pill Body -->
                                        <Button Grid.Column="1" Command="{Binding SelectSheetCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip="Click to inspect &amp; edit sheet views, scales, and symbols">
                                            <StackPanel HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SheetNumber}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Action}" FontSize="9" FontWeight="Bold" Foreground="{Binding ActionBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SheetName}" FontSize="10.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                                                <TextBlock Text="{Binding MatrixPillSummary}" FontSize="9.5" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>

                                        <!-- Quick Action Buttons on Pill -->
                                        <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Top" Margin="3,0,0,0">
                                            <Button Content="✕" Command="{Binding PurgeCommand}" Padding="3,0" Margin="0,0,0,2" FontSize="9" Background="Transparent" Foreground="{DynamicResource TextLightBrush}" ToolTip="Remove / Purge this sheet"/>
                                            <Button Content="+1" Command="{Binding CloneSheetCommand}" Padding="3,0" Margin="0" FontSize="9" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" ToolTip="Add (+1) another sheet in this cell"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Cell Quick-Add & 2x2 Sector Split Footer -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2,0,0">
                        <Button Content="{Binding CellPlaceholderText}" Command="{Binding AddSheetCommand}" Visibility="{Binding ShowQuickAdd, Converter={StaticResource BoolToVis}}" Padding="6,2" Margin="0,0,4,0" FontSize="10" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" ToolTip="Add a standardized AIA sheet + view directly into this Level × Series cell"/>
                        <Button Content="⊞ 2x2" Command="{Binding SplitSectorsCommand}" Visibility="{Binding CanSplitSectors, Converter={StaticResource BoolToVis}}" Padding="5,2" Margin="0" FontSize="10" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextLightBrush}" ToolTip="Split or un-split this cell into 4 Sector Sheets (A, B, C, D)"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Name="Bg" SnapsToDevicePixels="true">
                            <Border Background="{DynamicResource ControlBrush}" Opacity="0.5" />
                            <Track Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource HoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Margin="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. CUSTOM TITLE BAR -->
            <Grid Grid.Row="0" Background="{DynamicResource ToolbarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Name="TitleBarGrid" Grid.Column="0" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Manage Sheets — Building × Series Cartoon Matrix" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="{Binding MatrixSummaryText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="Btn_MinimizeWindow" Content="-" Width="30" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" FontSize="16" Cursor="Hand"/>
                    <Button Name="Btn_CloseWindow" Content="✕" Width="30" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" FontSize="14" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- 1. TOP COMMAND & COLLECTION STRIP -->
            <Border Grid.Row="1" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="12,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Sheet Collection, Add Sheet, Cartoon Overlay & Rule Book Drawer Toggle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Sheet Collection:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Name="Cmb_TargetCollection" IsEditable="True" Text="PERMIT SET" Width="180" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <Button Name="Btn_QuickAddSheet" Content="➕ Add Sheet" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12.5" Padding="9,5" Margin="0,0,10,0" ToolTip="Quick add a new sheet in active scope or level"/>
                        <CheckBox Name="Chk_AddMissing" Content="📐 Overlay Planned Cartoon Set" IsChecked="False" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,10,0" ToolTip="Include planned AIA schema sheets on the Matrix Board alongside existing Revit sheets"/>
                        <Button Name="Btn_ToggleCartoonDrawer" Content="{Binding DrawerToggleText}" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12.5" Padding="10,5" Margin="0" ToolTip="Open/Close Advanced Discipline &amp; Modifier Rule Book"/>
                    </StackPanel>

                    <!-- Center: One-Click Smart Automation -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Name="Btn_AutoSuggestViews" Content="⚡ Auto-Populate Views &amp; Scales" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontWeight="Bold" FontSize="12.5" Padding="12,5" Margin="0,0,6,0" ToolTip="Auto-assign unplaced Revit views or queue new views with standard scales, Graphic Scales, and North Arrows across all Matrix sheets"/>
                        <Button Command="{Binding AutoFixMessySheetsCommand}" Visibility="{Binding HasUnreconciledItems, Converter={StaticResource BoolToVis}}" Content="✨ Standardize Sheets" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontWeight="Bold" FontSize="12.5" Padding="12,5" Margin="0,0,6,0" ToolTip="Apply AIA Rule Book numbers &amp; names to all messy/unmatched sheets and slot them into the Matrix"/>
                    </StackPanel>

                    <!-- Right: Filter, Reload, Reset, Save/Export & Import -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Name="Chk_ShowInvalid" Content="⚠ Warnings Only" IsChecked="False" Click="on_filter_changed" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,8,0"/>
                        <Button Name="Btn_RefreshData" Content="↻ Reload" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" FontSize="12" Padding="8,4" Margin="0,0,4,0" ToolTip="Reload sheets and views from Revit"/>
                        <Button Name="Btn_ResetAll" Content="⟲ Reset" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontSize="12" Padding="6,4" Margin="0,0,8,0" ToolTip="Reset pending sandbox edits back to Revit baseline"/>
                        <Button Name="Btn_SaveProjectSettings" Content="💾 Save" FontSize="12" Padding="8,4" Margin="0,0,4,0" ToolTip="Save Cartoon Matrix settings to Revit project"/>
                        <Button Name="Btn_ExportSchema" Content="📤" FontSize="12" Padding="6,4" Margin="0,0,2,0" ToolTip="Export Schema to JSON"/>
                        <Button Name="Btn_ImportSchema" Content="📥" FontSize="12" Padding="6,4" Margin="0" ToolTip="Import Schema from JSON"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. COLLAPSIBLE CARTOON SET RULE DRAWER (COLLAPSED BY DEFAULT) -->
            <Border Name="CartoonDrawerPanel" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8" MaxHeight="220">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sector Grid Sliders & Reset -->
                    <Border Grid.Column="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Default Sector Grid" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rows:" VerticalAlignment="Center" Foreground="{DynamicResource TextLightBrush}" FontSize="12.5"/>
                                <Slider Name="Sld_GridRows" Grid.Column="1" Minimum="1" Maximum="10" Value="1" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                                <TextBlock Name="Txt_GridRows" Grid.Column="2" Text="{Binding ElementName=Sld_GridRows, Path=Value}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cols:" VerticalAlignment="Center" Foreground="{DynamicResource TextLightBrush}" FontSize="12.5"/>
                                <Slider Name="Sld_GridCols" Grid.Column="1" Minimum="1" Maximum="10" Value="1" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                                <TextBlock Name="Txt_GridCols" Grid.Column="2" Text="{Binding ElementName=Sld_GridCols, Path=Value}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <CheckBox Name="Chk_ShuffleOnExclude" Content="Shuffle on Exclude" IsChecked="False" FontSize="12" Margin="0,0,0,2"/>
                            <CheckBox Name="Tgl_ShowExcluded" Content="Show Excluded in Tree" IsChecked="False" FontSize="12" Margin="0,0,0,2"/>
                            <CheckBox Name="Chk_GlobalCover" Content="Global Cover (G-001)" IsChecked="True" FontSize="12" Margin="0,0,0,4"/>
                            
                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Name="Cmb_NamingScheme" Grid.Column="0" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Name="Btn_EditNamingSchemes" Grid.Column="1" Content="⚙" Width="20" Height="20" Padding="1" ToolTip="Edit Sector Schemes"/>
                            </Grid>

                            <Button Name="Btn_ClearProjectSettings" Content="🗑 Clear Saved Setup" Padding="4,2" FontSize="11.5" Background="Transparent" Foreground="{DynamicResource ErrorTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Building Levels -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,3">
                            <TextBlock Text="Building Levels" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Name="Btn_LevelAll" Content="All" Padding="3,0" FontSize="11.5" Background="Transparent" Foreground="{DynamicResource AccentBrush}"/>
                                <Button Name="Btn_LevelNone" Content="None" Padding="3,0" FontSize="11.5" Background="Transparent" Foreground="{DynamicResource AccentBrush}" Margin="0"/>
                            </StackPanel>
                        </Grid>
                        <TextBox Name="Txt_SearchLevels" Grid.Row="1" FontSize="12" Margin="0,0,0,3" Padding="2"/>
                        <ListBox Name="List_Levels" Grid.Row="2" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked, Mode=OneWay}" Click="on_checkbox_click" Margin="2,1"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Disciplines -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,3">
                            <TextBlock Text="Disciplines" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Name="Btn_DiscAll" Content="All" Padding="3,0" FontSize="11.5" Background="Transparent" Foreground="{DynamicResource AccentBrush}"/>
                                <Button Name="Btn_DiscNone" Content="None" Padding="3,0" FontSize="11.5" Background="Transparent" Foreground="{DynamicResource AccentBrush}" Margin="0"/>
                            </StackPanel>
                        </Grid>
                        <TextBox Name="Txt_SearchDisciplines" Grid.Row="1" FontSize="12" Margin="0,0,0,3" Padding="2"/>
                        <ListBox Name="List_Disciplines" Grid.Row="2" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=OneWay}" Click="on_checkbox_click" Margin="2,1"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Sheet Series -->
                    <Grid Grid.Column="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,3">
                            <TextBlock Text="AIA Series" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Name="Btn_SeriesAll" Content="All" Padding="3,0" FontSize="11.5" Background="Transparent" Foreground="{DynamicResource AccentBrush}"/>
                                <Button Name="Btn_SeriesNone" Content="None" Padding="3,0" FontSize="11.5" Background="Transparent" Foreground="{DynamicResource AccentBrush}" Margin="0"/>
                            </StackPanel>
                        </Grid>
                        <TextBox Name="Txt_SearchSeries" Grid.Row="1" FontSize="12" Margin="0,0,0,3" Padding="2"/>
                        <ListBox Name="List_Series" Grid.Row="2" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=OneWay}" Click="on_checkbox_click" Margin="2,1"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Name Modifiers -->
                    <Grid Grid.Column="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,3">
                            <TextBlock Text="Name Modifiers" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Name="Btn_ModAll" Content="All" Padding="3,0" FontSize="11.5" Background="Transparent" Foreground="{DynamicResource AccentBrush}"/>
                                <Button Name="Btn_ModNone" Content="None" Padding="3,0" FontSize="11.5" Background="Transparent" Foreground="{DynamicResource AccentBrush}"/>
                                <Button Name="Btn_EditModifiers" Content="⚙ Edit" Height="20" Padding="4,0" FontSize="11.5" Margin="2,0,0,0"/>
                                <Button Name="Btn_ExpandModifiers" Content="+" Padding="3,0" FontSize="12" Background="Transparent"/>
                                <Button Name="Btn_CollapseModifiers" Content="-" Padding="3,0" FontSize="12" Background="Transparent" Margin="0"/>
                            </StackPanel>
                        </Grid>
                        <TextBox Name="Txt_SearchModifiers" Grid.Row="1" FontSize="12" Margin="0,0,0,3" Padding="2"/>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource WindowBrush}">
                            <TreeView Name="Tree_Modifiers" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource BaseTreeItemStyle}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,1" IsEnabled="{Binding IsEnabled}">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" IsEnabled="{Binding IsEnabled}" Click="on_checkbox_click" IsThreeState="{Binding IsThreeState}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                    </Grid>

                    <!-- Schema Tree Override -->
                    <Grid Grid.Column="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,3">
                            <TextBlock Text="Schema Exclude Filter" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Name="Btn_ExpandSchema" Content="+" Padding="3,0" FontSize="12" Background="Transparent"/>
                                <Button Name="Btn_CollapseSchema" Content="-" Padding="3,0" FontSize="12" Background="Transparent" Margin="0"/>
                            </StackPanel>
                        </Grid>
                        <TextBox Name="Txt_SearchSchema" Grid.Row="1" FontSize="12" Margin="0,0,0,3" Padding="2"/>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource WindowBrush}">
                            <TreeView Name="TargetSchemaTree" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TargetSchemaTreeItemStyle}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,1" Opacity="{Binding TargetOpacity}">
                                            <CheckBox IsChecked="{Binding IsTargetIncluded, Mode=OneWay}" Click="on_target_checkbox_click" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. MAIN 3-PANE WORKSPACE -->
            <Grid Grid.Row="3" Margin="10,8,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="245" MinWidth="190"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="560"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="410" MinWidth="330"/>
                </Grid.ColumnDefinitions>

                <!-- COL 0: LEFT PANE - SHEET COLLECTIONS (NavTree) -->
                <Border Grid.Column="0" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                            <Grid>
                                <TextBlock Text="Sheet Collections" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Name="Btn_ExpandNav" Content="+" Padding="4,0" FontSize="13" Background="Transparent" Foreground="{DynamicResource TextBrush}" ToolTip="Expand All"/>
                                    <Button Name="Btn_CollapseNav" Content="-" Padding="4,0" FontSize="13" Background="Transparent" Foreground="{DynamicResource TextBrush}" Margin="0" ToolTip="Collapse All"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Visible NavTree -->
                        <TreeView Name="NavTree" Grid.Row="1" ItemsSource="{Binding NavRoot}" Background="Transparent" BorderThickness="0" Margin="4">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="{Binding FontWeight}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayCount}" Foreground="{DynamicResource TextLightBrush}" FontSize="12" VerticalAlignment="Center" Margin="3,0,0,0" Visibility="{Binding ShowCount, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- COL 1: GRIDSPLITTER -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

                <!-- COL 2: CENTER PANE - 2-TAB WORKBENCH -->
                <Border Grid.Column="2" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                    <TabControl Name="MainTabControl" Background="Transparent" BorderThickness="0" SelectedIndex="0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TabControl.ItemContainerStyle>
                        <!-- TAB 1: 📋 SHEET SCHEDULE -->
                        <TabItem Header="📋 Sheet Schedule" FontSize="12.5" FontWeight="SemiBold" Padding="14,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Strip -->
                                <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Name="Txt_GridTitle" Text="Sheet Schedule" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Text="Discipline:" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,6,0"/>
                                            <ComboBox Name="Cmb_DisciplineFilter" Width="185" FontSize="12.5" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Filter schedule by discipline"/>
                                            <StackPanel Name="AutoRefreshWarningPanel" Orientation="Horizontal" Visibility="Collapsed">
                                                <TextBlock Text="Large project" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Name="Chk_FillGaps" Content="Fill Number Gaps" IsChecked="True" VerticalAlignment="Center" FontSize="12.5"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Sticky Schedule Column Headers -->
                                <Border Grid.Row="1" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="290"/>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="215"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="✓" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="DISC &amp; STATUS" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextLightBrush}"/>
                                        <TextBlock Grid.Column="2" Text="WHAT IT WAS (IN REVIT)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextLightBrush}"/>
                                        <TextBlock Grid.Column="3" Text="" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="WHAT IT BECOMES (PROPOSAL / MODIFY)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextLightBrush}"/>
                                        <TextBlock Grid.Column="5" Text="DECISION" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                    </Grid>
                                </Border>

                                <!-- Scrollable Schedule ItemsControl -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl Name="EditorList" ItemsSource="{Binding EditorItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,7" PreviewMouseLeftButtonDown="on_editor_row_clicked">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsChecked}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.75"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="105"/>
                                                            <ColumnDefinition Width="290"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="215"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Col 0: CheckBox -->
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        <!-- Col 1: DISC & STATUS -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                                            <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding DisciplineName}">
                                                                <TextBlock Text="{Binding DisciplineShortLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding ActionBrush}" Margin="1,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Col 2: WHAT IT WAS (IN REVIT) -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding OriginalNumberDisplay}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding OriginalNameDisplay}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="225" ToolTip="{Binding OriginalNameDisplay}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding PlacedViewsBaselineText}" FontSize="11.5" Foreground="{DynamicResource TextLightBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PlacedViewsBaselineText}" Margin="0,1,0,0"/>
                                                        </StackPanel>

                                                        <!-- Col 3: DiffArrowText -->
                                                        <TextBlock Grid.Column="3" Text="{Binding DiffArrowText}" FontSize="16" FontWeight="Bold" Foreground="{Binding ActionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        <!-- Col 4: WHAT IT BECOMES (PROPOSAL / MODIFY) -->
                                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <!-- Line 1: Targets -->
                                                            <Grid Margin="0,0,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="110"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="135"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Grid.Column="0" Text="{Binding SheetNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="on_textbox_keydown" FontWeight="Bold" FontSize="13" Padding="5,3" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding AvailableNames}" Text="{Binding SheetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="on_textbox_keydown" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableSeriesOptions}" SelectedItem="{Binding OverrideSeriesText, Mode=TwoWay}" FontSize="12" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <!-- Line 2: Diff -->
                                                            <TextBlock Text="{Binding ChangeDiffSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ActionBrush}" Margin="1,1,0,2" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChangeDiffSummary}"/>
                                                            <!-- Line 3: View Matching bar -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding MatchedViewSummary}" FontSize="11.5" Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding MatchedViewSummary}"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="⇄ Sheet = View" Command="{Binding UseViewNameCommand}" Visibility="{Binding CanUseViewName, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" FontSize="11.5" Padding="6,2" Margin="3,0,0,0" ToolTip="Set Sheet Name to match primary view title"/>
                                                                    <Button Content="⇄ View = Sheet" Command="{Binding SyncNamesCommand}" Visibility="{Binding CanSyncViewToSheet, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" FontSize="11.5" Padding="6,2" Margin="3,0,0,0" ToolTip="Sync View titles to match Sheet Name"/>
                                                                    <Button Content="⚡ Match View" Command="{Binding AutoPopulateViewsCommand}" Visibility="{Binding HasNoViews, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" FontSize="11.5" Padding="6,2" Margin="3,0,0,0" ToolTip="Assign matching Revit model view or create view"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>

                                                        <!-- Col 5: DECISION -->
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Content="{Binding AcceptButtonText}" Command="{Binding AcceptSuggestionCommand}" Visibility="{Binding CanAcceptProposal, Converter={StaticResource BoolToVis}}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentTextBrush}" FontWeight="SemiBold" FontSize="12" Padding="8,4" Margin="0,0,4,0" ToolTip="Accept proposal or modifications"/>
                                                            <TextBlock Text="✓ Accepted" Visibility="{Binding IsAccepted, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <Button Content="↺ Undo" Command="{Binding UndoCommand}" Visibility="{Binding CanRevertOrUndo, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" FontSize="11.5" Padding="7,3" Margin="0,0,4,0" ToolTip="Revert to Revit original"/>
                                                            <Button Content="+1" Command="{Binding CloneSheetCommand}" Padding="6,2" Margin="0,0,3,0" FontSize="11.5" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" ToolTip="Clone sheet (+1)"/>
                                                            <Button Content="✕" Command="{Binding PurgeCommand}" Padding="6,2" Margin="0" FontSize="11.5" Background="Transparent" Foreground="{DynamicResource ErrorTextBrush}" ToolTip="Purge / Remove sheet"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- TAB 2: 📐 PLANS MATRIX (BY LEVEL) -->
                        <TabItem Header="📐 Plans Matrix (By Level)" FontSize="11.5" FontWeight="SemiBold" Padding="14,6" Visibility="Collapsed">
                            <!-- 2D Scrollable Matrix Grid -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Grid MinWidth="1220">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- STICKY MATRIX COLUMN HEADERS -->
                                    <Border Grid.Row="0" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="155"/>
                                                <ColumnDefinition Width="195"/>
                                                <ColumnDefinition Width="195"/>
                                                <ColumnDefinition Width="195"/>
                                                <ColumnDefinition Width="175"/>
                                                <ColumnDefinition Width="175"/>
                                                <ColumnDefinition Width="175"/>
                                                <ColumnDefinition Width="175"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="LEVEL / SCOPE" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="Top-to-Bottom Section" FontSize="9.5" Foreground="{DynamicResource TextLightBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="01A · FLOOR PLANS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="Site, Found, Floors, Roof" FontSize="9.5" Foreground="{DynamicResource TextLightBrush}"/>
                                                    </StackPanel>
                                                    <Button Content="+ All" Command="{Binding FillFloorPlansCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="5,1" Margin="0" FontSize="9.5" ToolTip="Ensure every Building Level has a Floor Plan sheet"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="01B · CEILING PLANS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="Reflected Ceiling (RCP)" FontSize="9.5" Foreground="{DynamicResource TextLightBrush}"/>
                                                    </StackPanel>
                                                    <Button Content="+ All" Command="{Binding FillCeilingPlansCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="5,1" Margin="0" FontSize="9.5" ToolTip="Ensure every Building Level has a Reflected Ceiling Plan sheet"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="01C · ENLARGED / SECTORS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="2x2 Quadrants, Core, Units" FontSize="9.5" Foreground="{DynamicResource TextLightBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="00 · GENERAL &amp; COVER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="Cover, Notes, Symbols" FontSize="9.5" Foreground="{DynamicResource TextLightBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="02 · ELEVATIONS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="Exterior &amp; Interior" FontSize="9.5" Foreground="{DynamicResource TextLightBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="03 · SECTIONS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="Building &amp; Wall Sections" FontSize="9.5" Foreground="{DynamicResource TextLightBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="7" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="05/06 · DETAILS &amp; SCHED" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="Details, Schedules, 3D" FontSize="9.5" Foreground="{DynamicResource TextLightBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- MATRIX SPATIAL ROWS (BUILDING SECTION TOP-TO-BOTTOM) -->
                                    <ItemsControl Name="MatrixBoard" Grid.Row="1" ItemsSource="{Binding MatrixRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="155"/>
                                                        <ColumnDefinition Width="195"/>
                                                        <ColumnDefinition Width="195"/>
                                                        <ColumnDefinition Width="195"/>
                                                        <ColumnDefinition Width="175"/>
                                                        <ColumnDefinition Width="175"/>
                                                        <ColumnDefinition Width="175"/>
                                                        <ColumnDefinition Width="175"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Row Header (Level / Spatial Scope) -->
                                                    <Border Grid.Column="0" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,8">
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding RowTitle}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding RowSubtitle}" FontSize="10" Foreground="{DynamicResource TextLightBrush}" Margin="0,2,0,4"/>
                                                            <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding RowBadge}" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 7 AIA Series Cells for this Spatial Row -->
                                                    <ContentControl Grid.Column="1" Content="{Binding CellFloorPlans}" ContentTemplate="{StaticResource MatrixCellTemplate}"/>
                                                    <ContentControl Grid.Column="2" Content="{Binding CellCeilingPlans}" ContentTemplate="{StaticResource MatrixCellTemplate}"/>
                                                    <ContentControl Grid.Column="3" Content="{Binding CellEnlargedPlans}" ContentTemplate="{StaticResource MatrixCellTemplate}"/>
                                                    <ContentControl Grid.Column="4" Content="{Binding CellGeneral}" ContentTemplate="{StaticResource MatrixCellTemplate}"/>
                                                    <ContentControl Grid.Column="5" Content="{Binding CellElevations}" ContentTemplate="{StaticResource MatrixCellTemplate}"/>
                                                    <ContentControl Grid.Column="6" Content="{Binding CellSections}" ContentTemplate="{StaticResource MatrixCellTemplate}"/>
                                                    <ContentControl Grid.Column="7" Content="{Binding CellDetails}" ContentTemplate="{StaticResource MatrixCellTemplate}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- COL 3: GRIDSPLITTER -->
                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

                <!-- COL 4: RIGHT PANE - SHEET & VIEW INSPECTOR (TOP) + AIA SUGGESTIONS BUCKET (BOTTOM) -->
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TOP RIGHT: ACTIVE SHEET & VIEW INSPECTOR -->
                    <Border Grid.Row="0" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                                <Grid>
                                    <TextBlock Text="Sheet &amp; View Inspector" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Inspect &amp; configure sheet" FontSize="12" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Selected Sheet Details -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSelectedSheet, Converter={StaticResource BoolToVis}}">
                                <StackPanel DataContext="{Binding SelectedSheet}" Margin="10">
                                    <!-- Status & Quick Actions Banner -->
                                    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{Binding ActionBrush}" BorderThickness="4,1,1,1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Action}" FontWeight="Bold" FontSize="13" Foreground="{Binding ActionBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding CollectionAndSeries}" Foreground="{DynamicResource TextLightBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="+1 Clone" Command="{Binding CloneSheetCommand}" Padding="7,3" FontSize="12" ToolTip="Add another sheet in this series"/>
                                                <Button Content="{Binding ToggleText}" Command="{Binding UndoCommand}" Padding="7,3" FontSize="12"/>
                                                <Button Content="🗑 Purge" Command="{Binding PurgeCommand}" Padding="7,3" FontSize="12" Background="Transparent" Foreground="{DynamicResource ErrorTextBrush}" Margin="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Reconciliation Baseline vs Proposal Card -->
                                    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="WHAT IT WAS IN REVIT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,3">
                                                    <TextBlock Text="{Binding OriginalNumberDisplay}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding OriginalNameDisplay}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ChangeDiffSummary}" FontSize="12" Foreground="{Binding ActionBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <Button Content="{Binding AcceptButtonText}" Command="{Binding AcceptSuggestionCommand}" Visibility="{Binding CanAcceptProposal, Converter={StaticResource BoolToVis}}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentTextBrush}" FontWeight="Bold" FontSize="12" Padding="8,4" Margin="0,0,4,0"/>
                                                <Button Content="↺ Undo" Command="{Binding UndoCommand}" Visibility="{Binding CanRevertOrUndo, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" FontSize="12" Padding="7,3"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Sheet Number, Name & Series Override -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="125"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="SHEET NUMBER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SheetNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="on_textbox_keydown" FontWeight="Bold" FontSize="13" Padding="5,3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                            <TextBlock Text="SHEET NAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,2"/>
                                            <ComboBox IsEditable="True" Text="{Binding SheetName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="on_textbox_keydown" FontSize="13" ItemsSource="{Binding AvailableNames}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="AIA SERIES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,2"/>
                                            <ComboBox ItemsSource="{Binding AvailableSeriesOptions}" SelectedItem="{Binding OverrideSeriesText, Mode=TwoWay}" FontSize="12.5"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Views, Scales & Documentation Symbols Section -->
                                    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="Placed &amp; Planned Views" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="⚡ Auto-Suggest" Command="{Binding AutoPopulateViewsCommand}" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Padding="7,2.5" FontSize="12"/>
                                                    <Button Content="Sync Names" Command="{Binding SyncNamesCommand}" Background="Transparent" Foreground="{DynamicResource TextLightBrush}" Padding="6,2.5" FontSize="12"/>
                                                    <Button Content="+ View" Command="{Binding AddViewCommand}" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Padding="7,2.5" FontSize="12" Margin="0"/>
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Views}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <!-- Row 1: Mode, Detail #, View Name, Delete -->
                                                                <Grid Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="42"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="28"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox Grid.Column="0" IsEditable="True" Text="{Binding AssignmentMode, Mode=TwoWay}" FontSize="12" Margin="0,0,4,0" ToolTip="New (generate view) or Existing (place model view)">
                                                                        <ComboBoxItem Content="New"/>
                                                                        <ComboBoxItem Content="Existing"/>
                                                                    </ComboBox>
                                                                    <TextBox Grid.Column="1" Text="{Binding ViewNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDetailNumberEditable}" KeyDown="on_textbox_keydown" FontSize="13" Padding="2" Margin="0,0,4,0" TextAlignment="Center" ToolTip="Detail Number"/>
                                                                    <TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="on_textbox_keydown" FontSize="13" Padding="2" Margin="0,0,4,0" ToolTip="View Name / Title on Sheet"/>
                                                                    <Button Grid.Column="3" Content="✕" Command="{Binding DeleteCommand}" Background="Transparent" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12" Padding="0" Margin="0" ToolTip="Remove View"/>
                                                                </Grid>

                                                                <!-- Row 2: Scale + Level/Type (or Existing Picker) + Graphic Scale & North Arrow -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <ComboBox Grid.Column="0" IsEditable="True" Text="{Binding Scale, Mode=TwoWay}" ItemsSource="{Binding AvailableScales}" FontSize="12" Margin="0,0,4,0" ToolTip="View Scale"/>

                                                                    <!-- New View Level + ViewFamilyType -->
                                                                    <Grid Grid.Column="1" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" Margin="0,0,4,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <ComboBox Grid.Column="0" IsEditable="True" Text="{Binding PlanType, Mode=TwoWay}" ItemsSource="{Binding AvailableViewFamilyTypes}" FontSize="12" Margin="0,0,2,0" ToolTip="View Family Type"/>
                                                                        <ComboBox Grid.Column="1" IsEditable="True" Text="{Binding LevelName, Mode=TwoWay}" ItemsSource="{Binding AvailableLevels}" FontSize="12" Margin="2,0,0,0" ToolTip="Building Level"/>
                                                                    </Grid>

                                                                    <!-- Existing Unplaced View Picker -->
                                                                    <ComboBox Grid.Column="1"
                                                                              ItemsSource="{Binding AvailableExistingViews}"
                                                                              SelectedItem="{Binding SelectedExistingView, Mode=TwoWay}"
                                                                              DisplayMemberPath="Name"
                                                                              FontSize="12"
                                                                              Visibility="{Binding ShowExistingViewPicker, Converter={StaticResource BoolToVis}}"
                                                                              Margin="0,0,4,0"
                                                                              ToolTip="Pick an unplaced Revit view"/>

                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <CheckBox Content="📏Scale" IsChecked="{Binding HasGraphicScale, Mode=TwoWay}" FontSize="11.5" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="Place &amp; sync Graphic Scale"/>
                                                                        <CheckBox Content="🧭North" IsChecked="{Binding HasNorthArrow, Mode=TwoWay}" IsEnabled="{Binding IsPlanView}" FontSize="11.5" VerticalAlignment="Center" ToolTip="Place North Arrow"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Warnings -->
                                                                <TextBlock Text="{Binding ValidationWarning}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="11.5" FontStyle="Italic" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- BOTTOM RIGHT: "RULE BOOK IN THE BACK POCKET" — AIA SUGGESTIONS / UNRECONCILED SHEETS BUCKET -->
                    <Border Grid.Row="1" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" MaxHeight="260" Visibility="{Binding HasUnreconciledItems, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                                <Grid>
                                    <TextBlock Text="{Binding UnreconciledCountText}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <Button Content="✨ Auto-Fix All" Command="{Binding AutoFixMessySheetsCommand}" HorizontalAlignment="Right" Padding="8,3" Margin="0" FontSize="12" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontWeight="SemiBold" ToolTip="Standardize all messy sheets below and slot them into the Matrix"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding UnreconciledItems}" Margin="6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Command="{Binding SelectSheetCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" HorizontalContentAlignment="Left">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding OriginalNumberDisplay}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding OriginalNameDisplay}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SuggestionBadge}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Content="{Binding AcceptButtonText}" Command="{Binding AcceptSuggestionCommand}" VerticalAlignment="Center" Padding="8,3" Margin="4,0,0,0" FontSize="12" Background="{DynamicResource ButtonBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontWeight="SemiBold" ToolTip="Apply proposal or modifications"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Hidden Compatibility Controls -->
                    <Button Name="Btn_ExpandEditor" Visibility="Collapsed"/>
                    <Button Name="Btn_CollapseEditor" Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <!-- 4. FOOTER STATUS & PUSH TO REVIT -->
            <Border Name="FooterBorder" Grid.Row="4" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Name="Txt_Status" Grid.Column="0" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource TextLightBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,15,0">
                        <TextBlock Text="Default TitleBlock:" VerticalAlignment="Center" Foreground="{DynamicResource TextLightBrush}" FontSize="12.5" Margin="0,0,10,0"/>
                        <ComboBox Name="Combo_TitleBlocks" Width="240" FontSize="12.5" DisplayMemberPath="Name" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="Btn_PrintLog" Content="Print Log" Background="{DynamicResource HoverBrush}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="13" Padding="14,7" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Name="Btn_Push" IsEnabled="{Binding IsPushEnabled}" Content="Push Matrix To Revit" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentTextBrush}" FontWeight="Bold" FontSize="14" Padding="28,7" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Resizing Grips (Thumbs) -->
            <Thumb Name="ResizeTop" Style="{StaticResource InvisibleThumbStyle}" Height="5" VerticalAlignment="Top" Cursor="SizeNS" Grid.RowSpan="5" Panel.ZIndex="99"/>
            <Thumb Name="ResizeBottom" Style="{StaticResource InvisibleThumbStyle}" Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" Grid.RowSpan="5" Panel.ZIndex="99"/>
            <Thumb Name="ResizeLeft" Style="{StaticResource InvisibleThumbStyle}" Width="5" HorizontalAlignment="Left" Cursor="SizeWE" Grid.RowSpan="5" Panel.ZIndex="99"/>
            <Thumb Name="ResizeRight" Style="{StaticResource InvisibleThumbStyle}" Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Grid.RowSpan="5" Panel.ZIndex="99"/>
            
            <Thumb Name="ResizeTopLeft" Style="{StaticResource InvisibleThumbStyle}" Width="7" Height="7" VerticalAlignment="Top" HorizontalAlignment="Left" Cursor="SizeNWSE" Grid.RowSpan="5" Panel.ZIndex="100"/>
            <Thumb Name="ResizeTopRight" Style="{StaticResource InvisibleThumbStyle}" Width="7" Height="7" VerticalAlignment="Top" HorizontalAlignment="Right" Cursor="SizeNESW" Grid.RowSpan="5" Panel.ZIndex="100"/>
            <Thumb Name="ResizeBottomLeft" Style="{StaticResource InvisibleThumbStyle}" Width="7" Height="7" VerticalAlignment="Bottom" HorizontalAlignment="Left" Cursor="SizeNESW" Grid.RowSpan="5" Panel.ZIndex="100"/>
            <Thumb Name="ResizeBottomRight" Style="{StaticResource InvisibleThumbStyle}" Width="7" Height="7" VerticalAlignment="Bottom" HorizontalAlignment="Right" Cursor="SizeNWSE" Grid.RowSpan="5" Panel.ZIndex="100"/>
        </Grid>
    </Border>
</Window>